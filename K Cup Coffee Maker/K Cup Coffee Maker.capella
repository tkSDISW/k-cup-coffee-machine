        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="4089362a-51a6-45ae-be7a-4c937d779134" name="Keep the equipment clean and performing"
            description="Need served: consistent cups over time with modest effort (routine cleaning and descaling). Drivers: convenience, lack of mess. May combine with capability 12 when tuning. Draft: NOTE-0002 revision 2, capability 10.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="d2411395-b117-497a-a51f-ed49a1dee1e7" involved="#689a685b-ebfd-4b53-bc72-e55c5727210d"/>
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
