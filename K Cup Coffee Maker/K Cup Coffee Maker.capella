        </ownedOperationalCapabilities>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="4dc6f3e5-d7bd-421f-91c0-dfe5b65aed10" name="Dispose of used coffee remains and packaging without mess"
            description="Need served: clean and quick clean-up after a cup. Drivers: lack of mess. Draft: NOTE-0002 revision 2, capability 4.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="cf06f8eb-43a3-41b1-aa92-c6a331b0fc23" involved="#689a685b-ebfd-4b53-bc72-e55c5727210d"/>
