        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="61cc6b71-b307-43f0-9b06-d58b33fbc086" name="Operate across a range of conditions"
            description="Need served: same simple routine at altitude and with different vessels. Drivers: convenience. May move to System Analysis when tuning. Draft: NOTE-0002 revision 2, capability 9.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="93a7e5ba-3a10-4e2f-bf85-74244f79e70c" involved="#65342e93-d242-4b83-8a78-cffa08d58b16"/>
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
