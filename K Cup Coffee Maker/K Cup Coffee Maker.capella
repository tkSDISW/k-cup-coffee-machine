        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="f0785c42-386a-42c3-a129-dc98443695a1" name="Return to readiness after idle"
            description="Need served: save energy without a long wait. Drivers: convenience. May move to System Analysis when tuning. Draft: NOTE-0002 revision 2, capability 8.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="4eddb7fa-918d-445a-97f7-2c395d98e5f7" involved="#65342e93-d242-4b83-8a78-cffa08d58b16"/>
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
