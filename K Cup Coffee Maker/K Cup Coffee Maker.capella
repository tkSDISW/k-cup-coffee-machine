        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="6c83cbaa-79b0-4c3f-974b-47f3932f205d"
            name="Coffee-Making Equipment" abstractType="#65342e93-d242-4b83-8a78-cffa08d58b16"/>
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="7b2e565b-4158-4747-b831-4d49ec223cb1"
            name="Coffee Supply Chain" abstractType="#9a67ade9-4d1a-4689-815d-e257c98195eb"/>
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="5fc83b7a-b00d-4e6e-9398-68762627937e"
            name="Equipment Support" abstractType="#95643ac7-ff7b-46e2-95a9-98f8518311de"/>
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="63a1e7ce-43ed-4519-91ec-fef736a46638"
            name="Waste Handling" abstractType="#cf58782e-8589-414a-b68b-c3f0acbd7196"/>
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="ab2fbbe3-830d-4109-beea-b64ace7fa48c"
            name="Utilities Supply" abstractType="#838b5f6c-a58b-41da-8180-182fd488bc2f"/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="689a685b-ebfd-4b53-bc72-e55c5727210d"
            name="Coffee Drinker" description="External actor. The person who wants a cup of coffee and carries out the everyday steps: choosing a serving, loading supplies, adding water, collecting the coffee, handling what is discarded, and routine cleaning."
            actor="true" human="true"/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="65342e93-d242-4b83-8a78-cffa08d58b16"
            name="Coffee-Making Equipment" description="The equipment that turns supplies and water into a served cup of coffee on request, and stays ready between uses. Modeled as a generic entity; later phases describe the specific design."/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="9a67ade9-4d1a-4689-815d-e257c98195eb"
            name="Coffee Supply Chain" description="Producers, packagers, retailers and delivery services that provide ready-to-use coffee supplies to the drinker. For this model the relevant outputs are the supplies and their packaging; growing, roasting and shipping the coffee itself are outside the boundary (DEC-0009)."/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="838b5f6c-a58b-41da-8180-182fd488bc2f"
            name="Utilities Supply" description="Provides the water and the electrical power that the equipment uses. One combined entity for now; water and power can be split later if the exchanges need it."/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="cf58782e-8589-414a-b68b-c3f0acbd7196"
            name="Waste Handling" description="The household and municipal routes that receive what the drinker discards: used coffee remains and packaging. This is where recycling, composting or disposal happens, and where the waste goals (coffee in, coffee out) are measured."/>
        <ownedEntities xsi:type="org.polarsys.capella.core.data.oa:Entity" id="95643ac7-ff7b-46e2-95a9-98f8518311de"
            name="Equipment Support" description="The manufacturer&amp;#x27;s support services that help the drinker with the equipment: guidance, replacement parts and warranty service."/>
      </ownedEntityPkg>
    </ownedArchitectures>
