        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="6c286e47-703d-42d3-a74b-13bf27484acb" name="Tailor the serving to the occasion"
            description="Need served: different cups for different moods and vessels (amount and strength). Drivers: convenience. Draft: NOTE-0002 revision 2, capability 2.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="f4475630-6b65-41bf-978f-538897fce58e" involved="#689a685b-ebfd-4b53-bc72-e55c5727210d"/>
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="0f168bed-62b6-491b-9bee-612beb683266" involved="#65342e93-d242-4b83-8a78-cffa08d58b16"/>
        </ownedOperationalCapabilities>
        <ownedOperationalCapabilities xsi:type="org.polarsys.capella.core.data.oa:OperationalCapability"
            id="74ad58bb-90ae-4017-99ae-f41510b8681b" name="Obtain ready-to-use coffee supplies in variety"
            description="Need served: coffee without measuring or handling loose ingredients. Drivers: convenience, lack of mess. Draft: NOTE-0002 revision 2, capability 3.">
          <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation"
              id="63fb289e-5eaf-42de-828d-cce2c33073b4" ReqIFLongName="Satisfy" source="#74ad58bb-90ae-4017-99ae-f41510b8681b"
