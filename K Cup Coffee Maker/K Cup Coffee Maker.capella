            id="966c2c17-8f77-460c-b588-4954e59b6724" name="Contain and clear spills and drips"
            description="Need served: a clean counter, any vessel. Drivers: lack of mess. Draft: NOTE-0002 revision 2, capability 5.">
          <ownedEntityOperationalCapabilityInvolvements xsi:type="org.polarsys.capella.core.data.oa:EntityOperationalCapabilityInvolvement"
              id="06aca530-4d7a-4a78-b630-fb22bbfe30d6" involved="#65342e93-d242-4b83-8a78-cffa08d58b16"/>
